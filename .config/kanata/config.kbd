(defcfg
  process-unmapped-keys yes
)
(defsrc
  lsft  caps  a  s  d  f  j  k  l  ; esc
)
(defvar
  tap-time 150
  hold-time 150
)
(defalias
  basetoggle (tap-dance $tap-time (esc esc (layer-switch base)))
  nomodstoggle (tap-dance $tap-time (esc esc (layer-switch nomods)))

  escctrl (tap-hold $tap-time $hold-time esc lctl)
  shifttab (tap-hold $tap-time $hold-time tab lsft)

  a (tap-hold $tap-time $hold-time a lalt)
  s (tap-hold $tap-time $hold-time s lctl)
  d (tap-hold $tap-time $hold-time d lmet)
  f (tap-hold $tap-time $hold-time f lsft)
  j (tap-hold $tap-time $hold-time j rsft)
  k (tap-hold $tap-time $hold-time k rmet)
  l (tap-hold $tap-time $hold-time l rctl)
  ; (tap-hold $tap-time $hold-time ; ralt)
)
(deflayer base
  @shifttab @escctrl @a  @s  @d  @f  @j  @k  @l  @; @nomodstoggle
)

(deflayer nomods
  lsft caps a   s   d   f   j   k   l   ; @basetoggle
)
